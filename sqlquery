-- BANK DATABASE DEMO
-- Microsoft SQL Server / T-SQL
-- All seed records are fictional placeholders. Do not insert real customer data here.

IF DB_ID(N'DB_BANK') IS NULL
BEGIN
    EXEC(N'CREATE DATABASE DB_BANK');
END;
GO

USE DB_BANK;
GO

-- Customer records
CREATE TABLE dbo.CUSTOMER
(
    CUSTOMER_ID INT NOT NULL CONSTRAINT PK_CUSTOMER PRIMARY KEY,
    CUSTOMER_NAME NVARCHAR(100) NOT NULL,
    DATE_OF_BIRTH DATE NULL,
    CONTACT_NO VARCHAR(20) NULL,
    ADDRESS NVARCHAR(200) NULL,
    GENDER NVARCHAR(20) NULL,
    EMAIL VARCHAR(254) NULL,
    MARITAL_STATUS NVARCHAR(20) NULL
);
GO

-- Bank and branch records
CREATE TABLE dbo.BANK_INFO
(
    IFSC_CODE VARCHAR(15) NOT NULL CONSTRAINT PK_BANK_INFO PRIMARY KEY,
    BANK_NAME NVARCHAR(100) NOT NULL,
    BRANCH_NAME NVARCHAR(100) NOT NULL
);
GO

-- Account records connect a customer with a bank
CREATE TABLE dbo.CUSTOMER_ACCOUNT
(
    ACCOUNT_ID INT NOT NULL CONSTRAINT PK_CUSTOMER_ACCOUNT PRIMARY KEY,
    CUSTOMER_ID INT NOT NULL,
    IFSC_CODE VARCHAR(15) NOT NULL,
    ACCOUNT_HOLDER_NAME NVARCHAR(100) NOT NULL,
    ACCOUNT_NUMBER VARCHAR(20) NOT NULL CONSTRAINT UQ_CUSTOMER_ACCOUNT_NUMBER UNIQUE,
    ACCOUNT_ADDRESS NVARCHAR(200) NULL,
    CONSTRAINT FK_CUSTOMER_ACCOUNT_CUSTOMER
        FOREIGN KEY (CUSTOMER_ID) REFERENCES dbo.CUSTOMER(CUSTOMER_ID),
    CONSTRAINT FK_CUSTOMER_ACCOUNT_BANK
        FOREIGN KEY (IFSC_CODE) REFERENCES dbo.BANK_INFO(IFSC_CODE)
);
GO

