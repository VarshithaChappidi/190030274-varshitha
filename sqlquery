-- Example relational query: view each customer, account, and bank together
SELECT
    c.CUSTOMER_ID,
    c.CUSTOMER_NAME,
    a.ACCOUNT_NUMBER,
    a.ACCOUNT_HOLDER_NAME,
    b.BANK_NAME,
    b.BRANCH_NAME
FROM dbo.CUSTOMER AS c
INNER JOIN dbo.CUSTOMER_ACCOUNT AS a
    ON a.CUSTOMER_ID = c.CUSTOMER_ID
INNER JOIN dbo.BANK_INFO AS b
    ON b.IFSC_CODE = a.IFSC_CODE;
